{
  "name": "geld-flow",
  "private": true,
  "version": "0.0.0",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.12.0",
  "scripts": {
    "dev:web": "pnpm --filter @geld-flow/web dev",
    "dev:api": "pnpm --filter @geld-flow/api dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @geld-flow/db generate",
    "db:migrate": "pnpm --filter @geld-flow/db migrate"
  }
}
