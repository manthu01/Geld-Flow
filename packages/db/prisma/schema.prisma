// Prisma schema for Geld Flow.
// Mirrors §6 of the technical specification. Model fields are camelCase
// (idiomatic for the generated client); @map keeps the actual Postgres
// columns snake_case to match the documented schema.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LedgerType {
  group_general
  group_travel
  group_event
  personal
}

enum LedgerRole {
  owner
  admin
  member
}

enum SplitType {
  equal
  percentage
  exact
}

enum SettlementStatus {
  pending
  confirmed
  declined
}

enum ActivityEventType {
  expense_added
  expense_edited
  expense_deleted
  settlement_requested
  settlement_confirmed
  settlement_declined
  member_joined
  member_left
  checklist_item_added
  checklist_item_completed
}

enum Rank {
  I
  II
  III
  IV
  V
}

enum AuthProvider {
  google
}

enum ChatPlatform {
  telegram
}

// ---------------------------------------------------------------- Identity

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  // Separate from `name`: a stable, unique, self-chosen handle. Every
  // account gets one generated at signup (from the email's local part)
  // so the field is never empty, but the user can change it any time
  // from the profile menu — unlike `name`, it must stay unique.
  username  String   @unique
  // Set only when the user actually changes their username (not on
  // signup) — lets updateProfile enforce a 14-day cooldown between
  // changes without needing a separate history table.
  usernameChangedAt DateTime? @map("username_changed_at")
  name      String
  avatarUrl String?  @map("avatar_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  // Shadow (unclaimed) member: created when an admin adds someone to a
  // personal ledger by name only, with no account yet. Uses a synthetic,
  // unguessable placeholder email (never a real login target) so the
  // unique email constraint still holds. Every money row (expenses,
  // shares, settlements, activity) is written against this row's id like
  // any other user, so once the real person redeems the claim link and
  // those rows are re-pointed at their real account, their history is
  // already complete — nothing needs backfilling.
  isShadow        Boolean   @default(false) @map("is_shadow")
  claimTokenHash  String?   @unique @map("claim_token_hash")
  claimExpiresAt  DateTime? @map("claim_expires_at")
  addedByUserId   String?   @map("added_by_user_id")

  addedBy           User?              @relation("ShadowAddedBy", fields: [addedByUserId], references: [id])
  shadowContacts    User[]             @relation("ShadowAddedBy")
  authIdentities    AuthIdentity[]
  refreshTokens     RefreshToken[]
  ledgerMembers     LedgerMember[]
  createdLedgers    Ledger[]           @relation("LedgerCreatedBy")
  createdInvites    Invite[]
  expensesPaid      Expense[]          @relation("ExpensePaidBy")
  expensesCreated   Expense[]          @relation("ExpenseCreatedBy")
  expenseShares     ExpenseShare[]
  settlementsFrom   Settlement[]       @relation("SettlementFrom")
  settlementsTo     Settlement[]       @relation("SettlementTo")
  activityEvents    ActivityEvent[]
  score             UserScore?
  badges            UserBadge[]
  checklistAssigned ChecklistItem[]    @relation("ChecklistAssignedTo")
  checklistCreated  ChecklistItem[]    @relation("ChecklistCreatedBy")
  chatLinks         ChatLink[]
  telegramLinkCodes TelegramLinkCode[]
  feedback          Feedback[]

  @@map("users")
}

model AuthIdentity {
  id             String       @id @default(uuid())
  userId         String       @map("user_id")
  provider       AuthProvider
  providerUserId String       @map("provider_user_id")
  createdAt      DateTime     @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([userId])
  @@map("auth_identities")
}

// Passwordless login tokens. Single-use: usedAt is set the moment the
// token is redeemed so a leaked link can't be replayed.
model MagicLinkToken {
  id        String    @id @default(uuid())
  email     String
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  @@index([email])
  @@map("magic_link_tokens")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ------------------------------------------------------------ Ledger core

// The shared engine table: a "Group" and a "Personal" split are both a
// Ledger, distinguished only by `type`. Every balance query is scoped to
// exactly one ledgerId — that scoping is what keeps a group debt and a
// personal debt between the same two people from ever being summed.
model Ledger {
  id              String     @id @default(uuid())
  type            LedgerType
  name            String?
  baseCurrency    String     @map("base_currency") @db.Char(3)
  createdById     String     @map("created_by")
  createdAt       DateTime   @default(now()) @map("created_at")
  archivedAt      DateTime?  @map("archived_at")
  // Set only when type = personal, normalized so personalUserAId is
  // always the lexicographically smaller user id. This is what lets a
  // partial unique index cap a friend pair at exactly one personal
  // ledger — see the raw-SQL index added in the migration that
  // introduces these columns, since Prisma's schema DSL has no partial
  // (WHERE-clause) unique constraints.
  personalUserAId String?    @map("personal_user_a_id")
  personalUserBId String?    @map("personal_user_b_id")

  createdBy         User               @relation("LedgerCreatedBy", fields: [createdById], references: [id])
  members           LedgerMember[]
  invites           Invite[]
  expenses          Expense[]
  settlements       Settlement[]
  activityEvents    ActivityEvent[]
  checklistItems    ChecklistItem[]
  chatLinks         ChatLink[]
  telegramLinkCodes TelegramLinkCode[]

  @@map("ledgers")
}

model LedgerMember {
  ledgerId String     @map("ledger_id")
  userId   String     @map("user_id")
  role     LedgerRole @default(member)
  joinedAt DateTime   @default(now()) @map("joined_at")

  ledger Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([ledgerId, userId])
  @@index([userId])
  @@map("ledger_members")
}

model Invite {
  id          String    @id @default(uuid())
  ledgerId    String    @map("ledger_id")
  tokenHash   String    @unique @map("token_hash")
  createdById String    @map("created_by")
  expiresAt   DateTime  @map("expires_at")
  maxUses     Int       @default(1) @map("max_uses")
  useCount    Int       @default(0) @map("use_count")
  revokedAt   DateTime? @map("revoked_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  ledger    Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([ledgerId])
  @@map("invites")
}

// Append-only. This is the activity ledger feature — every mutation
// worth showing in the timeline writes one row here.
model ActivityEvent {
  id        String            @id @default(uuid())
  ledgerId  String            @map("ledger_id")
  actorId   String            @map("actor_id")
  type      ActivityEventType
  payload   Json
  createdAt DateTime          @default(now()) @map("created_at")

  ledger Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  actor  User   @relation(fields: [actorId], references: [id])

  @@index([ledgerId, createdAt])
  @@map("activity_events")
}

// ----------------------------------------------------------------- Money

model Expense {
  id           String    @id @default(uuid())
  ledgerId     String    @map("ledger_id")
  description  String
  amount       Decimal   @db.Decimal(12, 2)
  currency     String    @db.Char(3)
  paidByUserId String    @map("paid_by") // who fronted the money
  splitType    SplitType @map("split_type")
  category     String?
  receiptUrl   String?   @map("receipt_url")
  createdById  String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  // Soft delete only — a voided expense stays for the audit trail but is
  // excluded from every balance and list query once this is set.
  deletedAt    DateTime? @map("deleted_at")

  ledger    Ledger         @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  paidBy    User           @relation("ExpensePaidBy", fields: [paidByUserId], references: [id])
  createdBy User           @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  shares    ExpenseShare[]

  @@index([ledgerId, createdAt])
  @@index([ledgerId, deletedAt])
  @@map("expenses")
}

// Computed once when the expense is written (or edited) and stored —
// never recalculated from splitType on read. See §2 "Expense logic".
model ExpenseShare {
  id              String   @id @default(uuid())
  expenseId       String   @map("expense_id")
  userId          String   @map("user_id")
  shareAmount     Decimal  @map("share_amount") @db.Decimal(12, 2)
  sharePercentage Decimal? @map("share_percentage") @db.Decimal(5, 2)

  expense Expense @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id])

  @@unique([expenseId, userId])
  @@map("expense_shares")
}

// status: pending -> confirmed | declined. Only "confirmed" affects a
// balance or the rank system — see §3 "Settlement integrity".
model Settlement {
  id          String           @id @default(uuid())
  ledgerId    String           @map("ledger_id")
  fromUserId  String           @map("from_user")
  toUserId    String           @map("to_user")
  amount      Decimal          @db.Decimal(12, 2)
  currency    String           @db.Char(3)
  status      SettlementStatus @default(pending)
  createdAt   DateTime         @default(now()) @map("created_at")
  confirmedAt DateTime?        @map("confirmed_at")

  ledger   Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  fromUser User   @relation("SettlementFrom", fields: [fromUserId], references: [id])
  toUser   User   @relation("SettlementTo", fields: [toUserId], references: [id])

  @@index([ledgerId])
  @@map("settlements")
}

// ------------------------------------------------------------ Gamification

// One row per user — rank is profile-wide, not per-ledger, since it's a
// signal about the person, not about any one group.
model UserScore {
  userId                String   @id @map("user_id")
  currentRank           Rank     @default(I) @map("current_rank")
  rollingAvgSettleHours Float?   @map("rolling_avg_settle_hours")
  confirmedSettlements  Int      @default(0) @map("confirmed_settlements")
  updatedAt             DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_scores")
}

model Badge {
  id            String @id @default(uuid())
  key           String @unique
  name          String
  description   String
  iconRef       String @map("icon_ref")
  criteriaType  String @map("criteria_type")
  criteriaValue String @map("criteria_value")

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  userId   String   @map("user_id")
  badgeId  String   @map("badge_id")
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@id([userId, badgeId])
  @@map("user_badges")
}

// ------------------------------------------------------- Contextual & bot

// Event-mode ledgers only; enforced in application code, not the schema.
model ChecklistItem {
  id           String    @id @default(uuid())
  ledgerId     String    @map("ledger_id")
  title        String
  isDone       Boolean   @default(false) @map("is_done")
  assignedToId String?   @map("assigned_to")
  dueDate      DateTime? @map("due_date")
  createdById  String    @map("created_by")
  createdAt    DateTime  @default(now()) @map("created_at")

  ledger     Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  assignedTo User?  @relation("ChecklistAssignedTo", fields: [assignedToId], references: [id])
  createdBy  User   @relation("ChecklistCreatedBy", fields: [createdById], references: [id])

  @@index([ledgerId])
  @@map("checklist_items")
}

// Maps a Telegram chat to the ledger it writes parsed expenses into.
// userId is nullable until whoever set up the link authenticates it.
model ChatLink {
  id             String       @id @default(uuid())
  userId         String?      @map("user_id")
  platform       ChatPlatform
  externalChatId String       @map("external_chat_id")
  externalUserId String?      @map("external_user_id")
  ledgerId       String       @map("ledger_id")
  linkedAt       DateTime     @default(now()) @map("linked_at")

  user   User?  @relation(fields: [userId], references: [id])
  ledger Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)

  @@unique([platform, externalChatId])
  @@map("chat_links")
}

// Short-lived, single-use code shown on a ledger's page and redeemed via
// "/link CODE" in Telegram to create that ledger's ChatLink — the same
// generate-a-token-then-redeem-it shape as MagicLinkToken and Invite.
model TelegramLinkCode {
  id          String    @id @default(uuid())
  code        String    @unique
  ledgerId    String    @map("ledger_id")
  createdById String    @map("created_by")
  expiresAt   DateTime  @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  ledger    Ledger @relation(fields: [ledgerId], references: [id], onDelete: Cascade)
  createdBy User   @relation(fields: [createdById], references: [id])

  @@index([ledgerId])
  @@map("telegram_link_codes")
}

// One-way: the About & Contact page's feedback form writes here. No
// in-app read path is built (yet) — this is a mailbox, not a feature.
model Feedback {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@map("feedback")
}
