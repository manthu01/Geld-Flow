# Copy to .env in this directory before running `pnpm dev:api`.

PORT=4000
WEB_APP_URL="http://localhost:3000"

# Matches the credentials in the root docker-compose.yml.
DATABASE_URL="postgresql://geldflow:geldflow@localhost:55432/geldflow"
REDIS_URL="redis://localhost:6379"

# Auth — generate real secrets with `openssl rand -hex 32`.
JWT_ACCESS_SECRET="dev-only-change-me"
JWT_REFRESH_SECRET="dev-only-change-me-too"
MAGIC_LINK_SIGNING_SECRET="dev-only-change-me-as-well"

# Google OAuth — from console.cloud.google.com. Optional until Phase 0's
# auth work lands; magic-link works without it.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Telegram bot — from @BotFather. Needed starting Phase 3.
TELEGRAM_BOT_TOKEN=""

# Fallback NLU for chat messages the deterministic parser can't confidently
# match. Needed starting Phase 3.
ANTHROPIC_API_KEY=""
