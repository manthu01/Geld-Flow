# Copy to .env in this directory before running `pnpm dev:api`.

NODE_ENV="development"
PORT=4000
API_BASE_URL="http://localhost:4000"
WEB_APP_URL="http://localhost:3000"

# Matches the credentials in the root docker-compose.yml.
DATABASE_URL="postgresql://geldflow:geldflow@localhost:55432/geldflow"
REDIS_URL="redis://localhost:6379"

# Signs access tokens. Refresh and magic-link tokens are random opaque
# strings hashed into the database, not JWTs, so they don't need a secret
# here. Generate a real value with `openssl rand -hex 32`.
JWT_ACCESS_SECRET="dev-only-change-me"

# Google OAuth — from console.cloud.google.com. Optional: magic-link
# sign-in works without it, and /auth/google returns a clear 503 until
# these are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_CALLBACK_URL="http://localhost:4000/auth/google/callback"

# Telegram bot — from @BotFather. Needed starting Phase 3.
TELEGRAM_BOT_TOKEN=""

# Fallback NLU for chat messages the deterministic parser can't confidently
# match. Needed starting Phase 3.
ANTHROPIC_API_KEY=""
