# Copy to .env.local before running `pnpm dev:web`.
NEXT_PUBLIC_API_URL="http://localhost:4000"

# UI-only: shows the hidden admin link in the sidebar for this email. Not
# a security boundary — the API's own ADMIN_EMAIL is what actually gates
# /admin/* routes. Optional: leave unset to hide the admin link entirely.
NEXT_PUBLIC_ADMIN_EMAIL=""
